---
Language: Cpp
BasedOnStyle: Google

AccessModifierOffset: -2
IndentWidth: 4
SpacesBeforeTrailingComments: 4
ColumnLimit: 120

IncludeBlocks: Preserve

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

DerivePointerAlignment: false

Standard: c++20

Macros:
    - WL_DEF_BUFFER_TARGET(target)=constexpr static GLenum s_target = target
    - HandlerImpl=template <class Id, class Allocator> auto Handler<Id, Allocator>
    - HandlerCtor=template <class Id, class Allocator> Handler<Id, Allocator>

---
